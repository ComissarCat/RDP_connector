<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>RDP_connector</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />
		<TrimmerRootAssembly Include="System.DirectoryServices" />
		<TrimmerRootAssembly Include="System.DirectoryServices.AccountManagement" />
		<TrimmerRootAssembly Include="System.DirectoryServices.Protocols" />
	</ItemGroup>

</Project>
